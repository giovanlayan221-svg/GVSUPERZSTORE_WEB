{
  "crons": [
    { "path": "/api/sync-pending", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "functions": {
    "api/haybi.js": { "maxDuration": 30 },
    "api/haybi-callback.js": { "maxDuration": 20 },
    "api/sync-pending.js": { "maxDuration": 30 },
    "api/punyakios-callback.js": { "maxDuration": 30 },
    "api/pkqris.js": { "maxDuration": 30 },
    "api/pay.js": { "maxDuration": 30 },
    "api/mangbeli-callback.js": { "maxDuration": 30 }
  }
}
